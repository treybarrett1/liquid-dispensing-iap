{
  "name": "liquid-dispensing-iap",
  "version": "1.0.0",
  "description": "Liquid dispenser coursework: durable run-history walking skeleton",
  "private": true,
  "scripts": {
    "build": "node scripts/build.mjs",
    "start": "node dist/server.js",
    "test": "vitest run test/dispensing.test.js test/run-history.test.js",
    "test:e2e": "playwright test",
